# AWS QA1 sanity account, package_info with latest version + dependency graph.
# Usage: CONFIG=aws-qa1 ./run.sh   (HARNESS_API_KEY comes from run.sh / your env)
# Override: PROFILE=focus BATCH_SIZE=1 CONFIG=aws-qa1 ./run.sh

export BASE_URL=https://aws-qa1-sanity-test-acc.harness-test.com
export API_PATH=/component-data-service/api/v1/package_info

export INCLUDE_LATEST_VERSION=true
export INCLUDE_DEPENDENCY_GRAPH="${INCLUDE_DEPENDENCY_GRAPH:-false}"

export PROFILE="${PROFILE:-step}"
