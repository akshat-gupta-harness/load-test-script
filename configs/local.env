# Local API (no gateway prefix; QA uses /component-data-service/...)
# Usage: CONFIG=local ./run.sh
#
# Defaults: PROFILE=batch100 (100 PURLs/POST); query flags off unless set.
# Optional overrides:
#   PROFILE=focus CONFIG=local ./run.sh
#   SKIP_CACHE=true CONFIG=local ./run.sh

export BASE_URL=http://localhost:8080
export API_PATH=/api/v1/package_info/cached

export PROFILE="${PROFILE:-batch100}"
