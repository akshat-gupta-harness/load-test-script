# QA0 prod1, package_info with latest version + EOL (dependency graph off by default).
# Usage: CONFIG=qa0 ./run.sh   (HARNESS_API_KEY comes from run.sh / your env)

export BASE_URL=https://qa0.harness.io
export API_PATH=/prod1/component-data-service/api/v1/package_info

export INCLUDE_LATEST_VERSION="${INCLUDE_LATEST_VERSION:-true}"
export INCLUDE_EOL="${INCLUDE_EOL:-true}"
export INCLUDE_DEPENDENCY_GRAPH="${INCLUDE_DEPENDENCY_GRAPH:-false}"

export PROFILE="${PROFILE:-slow}"
