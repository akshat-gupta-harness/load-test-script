        "y": 24
      },
      "id": 6,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "stackdriver_cloudsql_database_cloudsql_googleapis_com_database_disk_utilization{database_id=\"qa-setup:vulnerability-qa\"}",
          "legendFormat": "disk",
