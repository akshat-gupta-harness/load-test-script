{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "description": "GKE and Cloud SQL metrics for vulnservice, pulled from Cloud Monitoring by stackdriver-exporter and stored in Prometheus.",
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "CPU used as a fraction of the container's CPU request. 1.0 means the pod is using exactly what it asked for.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "fraction of request"
          },
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "stackdriver_k_8_s_container_kubernetes_io_container_cpu_request_utilization{namespace_name=\"harness-helm-new\", container_name=\"vulnservice\"}",
          "legendFormat": "{{pod_name}}",
          "refId": "A"
        }
      ],
      "title": "vulnservice — CPU request utilization",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Absolute CPU consumption in cores, summed across all vulnservice pods, shown against the total requested and total limit cores.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "cores"
          },
          "decimals": 2,
          "min": 0,
          "unit": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 8,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(stackdriver_k_8_s_container_kubernetes_io_container_cpu_core_usage_time{namespace_name=\"harness-helm-new\", container_name=\"vulnservice\"}[5m]))",
          "legendFormat": "cores used (5m rate)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(stackdriver_k_8_s_container_kubernetes_io_container_cpu_request_cores{namespace_name=\"harness-helm-new\", container_name=\"vulnservice\"})",
          "legendFormat": "cores requested",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(stackdriver_k_8_s_container_kubernetes_io_container_cpu_limit_cores{namespace_name=\"harness-helm-new\", container_name=\"vulnservice\"})",
          "legendFormat": "cores limit",
          "refId": "C"
        }
      ],
      "title": "vulnservice — CPU cores used",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Container memory in use, summed over evictable and non-evictable memory across all vulnservice pods.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "bytes"
          },
          "min": 0,
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(stackdriver_k_8_s_container_kubernetes_io_container_memory_used_bytes{namespace_name=\"harness-helm-new\", container_name=\"vulnservice\"})",
          "legendFormat": "memory used",
          "refId": "A"
        }
      ],
      "title": "vulnservice — memory used",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Memory used as a fraction of the container's memory request, summed over evictable and non-evictable memory.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "fraction of request"
          },
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 7,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod_name) (stackdriver_k_8_s_container_kubernetes_io_container_memory_request_utilization{namespace_name=\"harness-helm-new\", container_name=\"vulnservice\"})",
          "legendFormat": "{{pod_name}}",
          "refId": "A"
        }
      ],
      "title": "vulnservice — memory request utilization",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Inbound network throughput for vulnservice pods (GKE pod network received bytes).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "B/s"
          },
          "min": 0,
          "unit": "Bps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 9,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod_name) (rate(stackdriver_k_8_s_pod_kubernetes_io_pod_network_received_bytes_count{namespace_name=\"harness-helm-new\", pod_name=~\"vulnservice.*\"}[5m]))",
          "legendFormat": "{{pod_name}} rx",
          "refId": "A"
        }
      ],
      "title": "vulnservice — network receive",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Outbound network throughput for vulnservice pods (GKE pod network sent bytes).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "B/s"
          },
          "min": 0,
          "unit": "Bps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 10,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod_name) (rate(stackdriver_k_8_s_pod_kubernetes_io_pod_network_sent_bytes_count{namespace_name=\"harness-helm-new\", pod_name=~\"vulnservice.*\"}[5m]))",
          "legendFormat": "{{pod_name}} tx",
          "refId": "A"
        }
      ],
      "title": "vulnservice — network send",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Open backends (connections) per database on the vulnerability-qa instance.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "connections"
          },
          "min": 0,
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (database) (stackdriver_cloudsql_database_cloudsql_googleapis_com_database_postgresql_num_backends{database_id=\"qa-setup:vulnerability-qa\"})",
          "legendFormat": "{{database}}",
          "refId": "A"
        }
      ],
      "title": "Cloud SQL vulnerability-qa — connections",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "utilization"
          },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "stackdriver_cloudsql_database_cloudsql_googleapis_com_database_cpu_utilization{database_id=\"qa-setup:vulnerability-qa\"}",
          "legendFormat": "CPU",
          "refId": "A"
        }
      ],
      "title": "Cloud SQL vulnerability-qa — CPU",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
