    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(k6_http_reqs_total[$__rate_interval]))",
          "legendFormat": "requests/sec",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "RPS",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 4,
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (status) (rate(k6_http_reqs_total[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "RPS by status code",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 5,
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(k6_http_reqs_total{expected_response=\"false\"}[$__rate_interval])) / clamp_min(sum(rate(k6_http_reqs_total[$__rate_interval])), 1e-9)",
          "legendFormat": "error % (non-2xx + network)",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "k6_status_5xx_rate",
          "legendFormat": "5xx %",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Error rate %",
      "type": "timeseries"
    }
  ],
